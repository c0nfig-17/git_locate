# =====================================================================
# git_locate — example configuration
# =====================================================================
# Copy to config.yaml and edit. Anything you omit falls back to the
# built-in defaults (see gitlocate/config.py::DEFAULTS).
#
# SECRETS ARE NEVER STORED HERE. This file only names the environment
# variables that hold your secrets; the values are read from the env at
# runtime. Set them before running, e.g.:
#
#   export GITHUB_TOKEN=ghp_xxx           # GitHub API token (recommended)
#   export SERPER_API_KEY=xxx             # ONLY if you switch web_dork to serper
#   export NOTIFY_PROVIDER_CONFIG=~/.config/notify/provider-config.yaml
# =====================================================================

# --------------------------------------------------------------------
# Targets. You can pass these on the CLI (-c/-d, --company-file/--domain-file)
# OR list them here. CLI + files + these are merged and de-duplicated.
# --------------------------------------------------------------------
targets:
  companies: []            # e.g. ["Acme Corp", "Acme Labs"]
  domains: []              # e.g. ["acme.com", "acme.io"]
  companies_file: ""       # path to a file, one company per line
  domains_file: ""         # path to a file, one domain per line

github:
  token_env: GITHUB_TOKEN          # env var holding the GitHub token
  api_url: https://api.github.com
  per_page: 100
  max_pages: 3                     # search pages per query (100 * pages results)
  connect_timeout: 10              # seconds to establish a connection
  read_timeout: 30                 # seconds to wait for a response
  enumerate_owner_repos: true      # list repos of confirmed orgs/users
  owner_repo_min_confidence: 0.4   # only enumerate owners scoring >= this
  fetch_profiles: true             # pull blog/email to anchor on domains
  fetch_commit_emails: false       # sample commit emails (slower, stronger)
  commit_sample: 20
  search_by_domain: true           # search repos/accounts by the domain string
  search_email: true               # search accounts with in:email <domain>
  discover_orgs: true
  discover_repos: true
  discover_users: true
  search_in:                       # profile fields the Search API looks in
    orgs: [login, name, email]
    repos: [name, description]
    users: [login, name, email]

# --------------------------------------------------------------------
# Graph expansion: pivot from confirmed nodes to discover related assets.
#   org  -> public members (users)
#   user -> public organizations
#   repo -> contributors (optional; noisier)
# Bounded by depth, a global node cap, and a per-node fan-out cap.
# --------------------------------------------------------------------
expansion:
  enabled: true
  max_depth: 2                     # BFS hops from the seed nodes
  max_nodes: 400                   # global cap on pivoted nodes
  pivot_min_confidence: 0.3        # pivot from nodes at/above this score
  org_members: true
  user_orgs: true
  repo_contributors: false         # opt-in (can be noisy/expensive)
  per_owner_limit: 100

# --------------------------------------------------------------------
# Web-search ("dorking") source. Locates the official org the way a human
# would Google it. KEYLESS by default (DuckDuckGo) — no API account needed.
# Low volume on purpose: human names only, capped request count.
# --------------------------------------------------------------------
web_dork:
  enabled: true
  provider: duckduckgo             # duckduckgo (keyless) | serper (needs key)
  duckduckgo_endpoint: https://html.duckduckgo.com/html/
  # -- only used when provider: serper --
  api_key_env: SERPER_API_KEY
  endpoint: https://google.serper.dev/search
  num: 20
  # -- shared --
  use_variants: false              # false = query the human company names only
  max_queries: 12                  # hard cap on web requests per run
  delay_seconds: 1.0               # politeness delay between web requests
  connect_timeout: 10
  read_timeout: 30
  queries:
    - "site:github.com {name}"
    - '"{name}" github'

# --------------------------------------------------------------------
# Name -> search-variant generation. The registrable label of each domain
# (acme.com -> "acme") is added automatically as an extra name seed, so
# domains are useful WITH and WITHOUT their TLD.
# --------------------------------------------------------------------
variants:
  separators: ["", " ", "-", "_"]
  suffixes: [inc, labs, io, hq, dev, corp, tech, sec]
  include_word_combos: true
  min_word_len: 2
  max_variants: 60
  max_total_variants: 120

# --------------------------------------------------------------------
# Confidence scoring (per-entity sum clamped to 1.0).
# --------------------------------------------------------------------
scoring:
  weights:
    domain_anchor: 0.5             # target domain on profile/homepage/commit
    exact_name_match: 0.3          # a variant == login or name
    description_match: 0.15        # a variant inside the description
    multi_source: 0.2              # seen via >1 source
    web_dork: 0.15                 # surfaced by web dorking
    owner_confirmed: 0.25          # (repos) owner is a confirmed org/user
    commit_email_domain: 0.3       # sampled commit email hits a target domain
    domain_search: 0.15            # found by searching the target domain string
    org_member: 0.2                # public member of a confirmed org
    related: 0.1                   # other pivot relation (user's org, contributor)
  min_confidence: 0.0              # drop entities scoring below this

# --------------------------------------------------------------------
# GitHub rate-limit handling: automatic waits until reset (only on genuine
# rate-limit responses; a plain 403 returns immediately).
# --------------------------------------------------------------------
rate_limit:
  auto_wait: true
  proactive: true                  # wait BEFORE a call when the bucket is empty
  max_wait_seconds: 900
  retry_max: 5
  backoff_base: 2.0

# --------------------------------------------------------------------
# Output artifacts (all consumable by later tools with no manual steps).
# --------------------------------------------------------------------
output:
  dir: ./output
  json_file: results.json          # structured orgs/repos/users + summary
  repos_flat_file: repos.txt       # flat repo URLs, ready to chain
  notify_file: notify.txt          # Notify-compatible plain-text payload
  pretty: true

# ====================================================================
# PHASE 2 — tool chaining: run external leak/recon tools per discovered repo.
# Runs BY DEFAULT (enabled: true). Disable for a run with --no-chain.
# ====================================================================
chaining:
  enabled: true                    # phase 2 runs by default (--no-chain to skip)
  workdir: ./output/chaining
  clone: true                      # clone each repo so {clone_dir} tools work
  timeout_seconds: 1800
  min_confidence: 0.0              # only chain over repos scoring >= this
  commands:
    # ==================== BLOQUE PARA PEGAR HERRAMIENTAS ====================
    # One shell command per discovered repo. Placeholders:
    #   {repo_url}   https clone URL      {repo}   owner/name
    #   {owner}      owner login          {name}   repo name
    #   {clone_dir}  local clone path (needs clone: true)
    #   {output_dir} = chaining.workdir
    #
    # A command whose leading tool is NOT installed is skipped with an install
    # hint (not a failure), so a partial toolbox still produces results.
    #
    # Prefer the wrappers install.sh puts on PATH (gitdorker, git-wild-hunt,
    # credsweeper): each runs its tool from its OWN venv. Do NOT call
    # 'python3 /opt/GitDorker/GitDorker.py' directly — that uses the system
    # python, which lacks the tool's deps ('No module named termcolor').
    # trufflehog: --no-update stops it self-updating a root-owned binary mid-run.
    #
    # These two work out of the box after ./install.sh:
    - "trufflehog git {repo_url} --no-update --json >> {output_dir}/trufflehog.jsonl"
    - "gitleaks detect --source {clone_dir} --report-format json --report-path {output_dir}/{owner}__{name}.gitleaks.json"
    # Uncomment to add more (keep the four leading spaces):
    # - "credsweeper --path {clone_dir} --save-json {output_dir}/{owner}__{name}.credsweeper.json"
    # - "gitdorker -tf /opt/GitDorker/token.txt -q {name} -d /opt/GitDorker/Dorks/medium_dorks.txt"
    # - "git-wild-hunt -s {repo_url}"
    # - "github-subdomains -d {name} -t $GITHUB_TOKEN -o {output_dir}/{owner}__{name}.subdomains.txt"
    # =======================================================================

# --------------------------------------------------------------------
# ProjectDiscovery Notify integration (webhook fan-out).
# By default a Notify message fires at the PHASE 1 -> PHASE 2 boundary
# (enumeration done, leak discovery starting). Phase 3 (per-leak alerts) is
# done by the chaining tools piping their own findings into `notify`.
#
# Webhooks/secrets live in Notify's OWN provider-config YAML, not here. In that
# file each provider key appears ONCE and holds a LIST of destinations:
#   custom:
#     - id: one
#       custom_webhook_url: https://example.com/one
#     - id: two
#       custom_webhook_url: https://example.com/two
# Repeating the `custom:` key instead of adding a list item makes Notify fail
# with 'could not parse provider config file ... mapping key "custom" already
# defined'. Validate it with: gitlocate --check-notify-config
# --------------------------------------------------------------------
notify:
  enabled: false                   # force-send regardless of phase
  on_phase_transition: true        # send when phase 1 -> phase 2
  binary: notify
  provider_config_env: NOTIFY_PROVIDER_CONFIG   # path to notify's provider yaml
  provider_config: ""              # optional explicit path (env var wins)
  provider_id: ""                  # notify -id value, e.g. "recon"
  bulk: true
  payload: phase_transition        # phase_transition | summary | repos | json
